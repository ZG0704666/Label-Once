    <Border Grid.Row="3" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="12,6"><Grid><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="12"/></Grid.RowDefinitions><DockPanel><TextBlock DockPanel.Dock="Left" Text="{Binding ProgressText}" FontSize="13" Margin="0,0,24,0"/><TextBlock DockPanel.Dock="Right" Text="{Binding GateStatusText}" ToolTip="{Binding GateStatusText}" Foreground="#D8C98A" Margin="12,0,0,0"/><TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" TextTrimming="CharacterEllipsis" Foreground="#B9C6D1"/></DockPanel><ProgressBar Grid.Row="1" Value="{Binding DisplayProgress, Mode=OneWay}" Maximum="1" Height="10" IsIndeterminate="{Binding ProgressIndeterminate}" Foreground="{StaticResource Accent}"/></Grid></Border>
