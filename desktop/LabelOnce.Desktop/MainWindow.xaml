ource {x:Type ComboBox}}" Width="126" ItemsSource="{Binding AnnotationMethods}" SelectedItem="{Binding AnnotationMethod}"/><Button Content="画框 W" Command="{Binding ActionCommand}" CommandParameter="draw"/><Button Content="多边形 P" Command="{Binding ActionCommand}" CommandParameter="polygon"/><Button Content="选择 Esc" Command="{Binding ActionCommand}" CommandParameter="select"/><Button Content="删除 Del" Command="{Binding ActionCommand}" CommandParameter="delete"/><Button Content="撤销 Ctrl+Z" Command="{Binding ActionCommand}" CommandParameter="undo"/><Button Content="重做 Ctrl+Y" Command="{Binding ActionCommand}" CommandParameter="redo"/><Button Visibility="{Binding SamToolsVisibility}" Content="＋ 正点 Q" Command="{Binding ActionCommand}" CommandParameter="sam-point"/><Button Visibility="{Binding SamToolsVisibility}" Content="− 负点 E" Command="{Binding ActionCommand}" CommandParameter="sam-negative"/><Button Content="YOLO 预标注" Visibility="{Binding YoloToolsVisibility}" Command="{Binding ActionCommand}" CommandParameter="prelabel"/><Button Visibility="{Binding SamToolsVisibility}" Content="SAM 框" Command="{Binding ActionCommand}" CommandParameter="sam-box"/><Button Visibility="{Binding SamToolsVisibility}" Content="新目标" Command="{Binding ActionCommand}" CommandParameter="sam-new"/><Button Visibility="{Binding SamToolsVisibility}" Content="清除本次分割" Command="{Binding ActionCommand}" CommandParameter="sam-clear"/></ToolBar></ToolBarTray></DockPanel></Border>
