            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="训练" FontSize="24" Margin="10,12"/><GroupBox Header="数据集版本"><StackPanel><ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"/><WrapPanel><Button Content="重新划分" Command="{Binding ActionCommand}" CommandParameter="dataset"/><Button Content="增量版本" Command="{Binding ActionCommand}" CommandParameter="incremental"/><Button Content="激活" Command="{Binding ActionCommand}" CommandParameter="activate"/><Button Content="整合数据集" ToolTip="多来源智能整合：外部 YOLO 目录、跨项目版本、本项目历史版本；先预览后写入；类别按名映射只追加。" Command="{Binding ActionCommand}" CommandParameter="dataset-merge"/></WrapPanel><TextBlock Text="待完成样本自动排除；空标签需明确完成。" Foreground="#9DABB8" TextWrapping="Wrap" Margin="6"/></StackPanel></GroupBox><GroupBox Header="训练参数"><StackPanel><TextBlock Text="初始模型"/><ComboBox IsEditable="True" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"/><Button Content="浏览权重" Command="{Binding ActionCommand}" CommandParameter="model-browse"/><UniformGrid Columns="2"><TextBlock Text="轮数" ToolTip="训练总轮数，小数据集 50-100，大数据集 100-300"/><ui:TextBox Text="{Binding Epochs,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Batch" ToolTip="每轮送入的图片数；显存不足时调小（常用 8/16/32）"/><ui:TextBox Text="{Binding Batch,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="设备" ToolTip="cpu / 0（第一块 GPU）/ 0,1（多卡）"/><ComboBox IsEditable="True" ItemsSource="{Binding Devices}" Text="{Binding Device}"/><Grid/></UniformGrid><Expander Header="高级设置 · 学习率 / 输入尺寸 / 增强 / 预设" Margin="0,4"><StackPanel><UniformGrid Columns="2"><TextBlock Text="学习率" ToolTip="默认 0.01；微调可降到 0.001"/><ui:TextBox Text="{Binding LearningRate,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="输入尺寸" ToolTip="训练分辨率（640 常用）；越大越准越慢"/><ui:TextBox Text="{Binding Imgsz,UpdateSourceTrigger=PropertyChanged}"/></UniformGrid><WrapPanel><Button Content="高级参数" Command="{Binding ActionCommand}" CommandParameter="advanced"/><Button Content="数据增强" Command="{Binding ActionCommand}" CommandParameter="augments"/><Button Content="恢复默认" Command="{Binding ActionCommand}" CommandParameter="defaults"/><Button Content="保存预设" Command="{Binding ActionCommand}" CommandParameter="preset-save"/><Button Content="加载预设" Command="{Binding ActionCommand}" CommandParameter="preset-load"/></WrapPanel></StackPanel></Expander><UniformGrid Columns="2"><Button Content="开始训练" Style="{StaticResource Primary}" Command="{Binding ActionCommand}" CommandParameter="train"/><Button Content="续训上次" ToolTip="从最近一次训练留下的 last.pt 继续" Command="{Binding ActionCommand}" CommandParameter="train-resume"/></UniformGrid></StackPanel></GroupBox><GroupBox Header="发布门禁"><StackPanel><Button Content="运行门禁检查" Command="{Binding ActionCommand}" CommandParameter="gate"/><TextBlock Text="五判据校验：类表一致、标签格式、影子泄漏、基线前缀、mAP50/AP50 与量化掉点；报告写入 Model/release_gate.json。" Foreground="#9DABB8" TextWrapping="Wrap" Margin="6"/></StackPanel></GroupBox></StackPanel></ScrollViewer>
            <Grid Grid.Column="1" Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="220"/></Grid.RowDefinitions><Border Background="{StaticResource Card}" CornerRadius="10" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="170"/></Grid.RowDefinitions><Image Source="{Binding CurveImage}" Stretch="Uniform"/><local:TrainingCurve Grid.Row="1" Epochs="{Binding EpochMetrics}"/></Grid></Border><DockPanel Grid.Row="1" Margin="4,10"><Button DockPanel.Dock="Right" Content="对比所选实验" Click="CompareExperiments"/><TextBlock Text="实验记录与训练曲线" FontSize="18"/></DockPanel><ListBox Grid.Row="2" x:Name="ExperimentList" ItemsSource="{Binding Experiments}" SelectionMode="Extended" SelectionChanged="ExperimentSelection"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding [experiment_id]}" FontWeight="SemiBold"/><TextBlock Text="{Binding [status]}" Foreground="#9DABB8"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
          </Grid>
          <Grid x:Name="ModelPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Background="{StaticResource Card}" CornerRadius="9" Padding="10"><WrapPanel><TextBlock Text="模型" FontSize="22" Margin="8,0,16,0"/><ComboBox Width="300" IsEditable="True" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"/><Button Content="浏览" Command="{Binding ActionCommand}" CommandParameter="model-browse"/><TextBlock Text="设备" Margin="8,0"/><ComboBox Width="100" IsEditable="True" ItemsSource="{Binding Devices}" Text="{Binding ModelDevice}"/><TextBlock Text="置信度" Margin="8,0"/><ui:TextBox Width="60" Text="{Binding Conf,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="IoU" Margin="8,0"/><ui:TextBox Width="60" Text="{Binding Iou,UpdateSourceTrigger=PropertyChanged}"/></WrapPanel></Border>
            <TabControl Grid.Row="1" Margin="0,10"><TabItem Header="推理"><WrapPanel><ui:TextBox Width="340" Text="{Binding Source,UpdateSourceTrigger=PropertyChanged}"/><Button Content="文件" Command="{Binding ActionCommand}" CommandParameter="source-file"/><Button Content="文件夹" Command="{Binding ActionCommand}" CommandParameter="source-folder"/><ComboBox ItemsSource="{Binding PredictModes}" SelectedItem="{Binding PredictMode}"/><Button Content="运行推理" Style="{StaticResource Primary}" Command="{Binding ActionCommand}" CommandParameter="predict"/></WrapPanel></TabItem><TabItem Header="评估"><WrapPanel><TextBlock Text="数据版本 · test 分组" Margin="10"/><ComboBox Width="320" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"/><Button Content="评估" Style="{StaticResource Primary}" Command="{Binding ActionCommand}" CommandParameter="evaluate"/></WrapPanel></TabItem><TabItem Header="导出"><WrapPanel><ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding ExportFormat}"/><TextBlock Text="精度位数" Margin="8,0"/><ComboBox ItemsSource="{Binding Precisions}" SelectedItem="{Binding Precision}"/><Button Content="高级参数" Command="{Binding ActionCommand}" CommandParameter="export-params"/><Button Content="导出模型" Style="{StaticResource Primary}" Command="{Binding ActionCommand}" CommandParameter="export"/></WrapPanel></TabItem></TabControl>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#10141A" CornerRadius="9" Padding="8" Margin="0,0,8,0"><Image Source="{Binding PreviewPath}" Stretch="Uniform"/></Border><DataGrid Grid.Column="1" ItemsSource="{Binding Detections}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="图片" Binding="{Binding [image]}" Width="*"/><DataGridTextColumn Header="类别" Binding="{Binding [name]}"/><DataGridTextColumn Header="得分" Binding="{Binding [score]}"/><DataGridTextColumn Header="耗时 ms" Binding="{Binding [latency_ms]}"/></DataGrid.Columns></DataGrid></Grid><Expander Grid.Row="3" Header="结果详情 / 评估指标"><ui:TextBox Text="{Binding ResultJson,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" MaxHeight="220" VerticalScrollBarVisibility="Auto"/></Expander>
          </Grid>
          <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="20"><Button Content="返回标注工作台" Command="{Binding ActionCommand}" CommandParameter="annotation"/><TextBlock Text="设置" FontSize="26" Margin="6,12"/><GroupBox Header="标注与模型高级设置"><WrapPanel><TextBlock Text="SAM / SAM2" Margin="6,0"/><ComboBox Width="180" IsEditable="True" ItemsSource="{Binding SamModels}" SelectedItem="{Binding SelectedSam}"/><Button Content="权重" Command="{Binding ActionCommand}" CommandParameter="sam-browse"/><TextBlock Text="轮廓精度（精细 0.5 / 标准 1 / 简洁 2）"/><ui:TextBox Width="60" Text="{Binding ContourPrecision,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="输入尺寸"/><ui:TextBox Width="70" Text="{Binding SamSize,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="设备"/><ComboBox Width="85" IsEditable="True" ItemsSource="{Binding Devices}" Text="{Binding Device}"/><TextBlock Text="YOLO" Margin="8,0,0,0"/><ComboBox Width="170" IsEditable="True" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"/><Button Content="模型" Command="{Binding ActionCommand}" CommandParameter="model-browse"/><TextBlock Text="置信度"/><ui:TextBox Width="60" Text="{Binding Conf,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="IoU"/><ui:TextBox Width="60" Text="{Binding Iou,UpdateSourceTrigger=PropertyChanged}"/><Button Content="AI 预标注" Command="{Binding ActionCommand}" CommandParameter="prelabel"/><Button Content="清除 AI" Command="{Binding ActionCommand}" CommandParameter="clear-ai"/></WrapPanel></GroupBox><GroupBox Header="应用"><StackPanel><TextBlock Text="应用名称"/><ui:TextBox Text="{Binding Brand}"/><TextBlock Text="图标"/><DockPanel><Button DockPanel.Dock="Right" Content="浏览" Command="{Binding ActionCommand}" CommandParameter="logo"/><ui:TextBox Text="{Binding LogoPath}"/></DockPanel><TextBlock Text="SAM / SAM2 输入尺寸"/><ui:TextBox Text="{Binding SamSize,UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="背景材质（Mica 微纹理 · 关闭时使用纯色深底）" IsChecked="{Binding Acrylic}"/><CheckBox Content="启动时显示主页（快速开始与最近项目）" IsChecked="{Binding ShowHomeAtStartup}"/><Button Content="保存设置" Style="{StaticResource Primary}" Command="{Binding ActionCommand}" CommandParameter="settings-save"/></StackPanel></GroupBox><GroupBox Header="运行与恢复"><StackPanel><TextBlock Text="本地 Python 后端 · 项目与 YOLO 标签保持兼容" Margin="6"/><WrapPanel><Button Content="重启后端" Command="{Binding ActionCommand}" CommandParameter="restart"/><Button Content="强制停止任务" Command="{Binding ActionCommand}" CommandParameter="force-stop"/></WrapPanel><TextBlock Text="R 适配 · Ctrl+滚轮缩放 · 滚轮上下滚动 · 中键 / 空格平移 · W 画框 · A/D 切换 · F 完成" TextWrapping="Wrap" Foreground="#9DABB8" Margin="6"/></StackPanel></GroupBox><GroupBox Header="最近项目"><ListBox ItemsSource="{Binding Recent}" MouseDoubleClick="RecentProject"/></GroupBox></StackPanel></ScrollViewer>
        </Grid>
      </Grid>
