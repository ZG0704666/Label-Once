<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 材质令牌：全部不透明。Mica 底纹由窗口层提供，控件层不再使用半透明叠加，避免亮壁纸下发灰。 -->
  <SolidColorBrush x:Key="Accent" Color="#42D9EA"/>
  <SolidColorBrush x:Key="Bg0" Color="#161B21"/>
  <SolidColorBrush x:Key="Bg1" Color="#1C222A"/>
  <SolidColorBrush x:Key="Bg2" Color="#20262E"/>
  <SolidColorBrush x:Key="Bg3" Color="#28303A"/>
  <SolidColorBrush x:Key="Stroke" Color="#3A4552"/>
  <SolidColorBrush x:Key="Card" Color="#20262E"/>
  <SolidColorBrush x:Key="Line" Color="#3A4552"/>
  <SolidColorBrush x:Key="TextPrimary" Color="#E8EDF4"/>
  <SolidColorBrush x:Key="TextSecondary" Color="#9DABB8"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Background" Value="#2B333D"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#3A4552"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#216575"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#38CBDD"/><Setter Property="Foreground" Value="#071A20"/><Setter Property="BorderBrush" Value="#54E3F1"/></Style>
  <Style x:Key="HomeAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,10"><ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2A333E"/><Setter TargetName="Surface" Property="BorderBrush" Value="#4E5B69"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#216575"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="HomeCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Bg2}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="16,14"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Background" Value="#242B34"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CaretBrush" Value="{StaticResource Accent}"/><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="3"/><Setter Property="SelectionBrush" Value="#238598"/><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}"><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Background" Value="#2A323C"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="3"/><Setter Property="MinWidth" Value="90"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemSurface" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#34424E"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#284C58"/><Setter Property="Foreground" Value="#6EEAF5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  <Style TargetType="GroupBox"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupBox"><Border CornerRadius="10" Background="{StaticResource Bg2}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><DockPanel><ContentPresenter DockPanel.Dock="Top" ContentSource="Header" Margin="0,0,0,14"/><ContentPresenter/></DockPanel></Border></ControlTemplate></Setter.Value></Setter><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="6"/></Style>
  <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}"><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Margin" Value="6"/></Style>
  <Style TargetType="Expander"><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Margin" Value="6"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#202730"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="RowBackground" Value="#202730"/><Setter Property="AlternatingRowBackground" Value="#29313B"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#303B46"/><Setter Property="Foreground" Value="#ACDAE1"/><Setter Property="Padding" Value="10,8"/></Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TabItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabSurface" Background="#303B46" CornerRadius="7" Padding="14,8" Margin="3"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#226172"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Padding" Value="14,7"/><Setter Property="Background" Value="#303B46"/></Style>
</ResourceDictionary>
